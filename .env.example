# Copia este archivo como .env y pon los valores reales de tu proyecto de Firebase.
# (Consola de Firebase > Configuracion del proyecto > Tus apps > SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Solo servidor (Vercel) — NO llevan prefijo VITE_ y NUNCA van al navegador ---
# Stripe: panel de Stripe > Desarrolladores > Claves de API (usa las de PRUEBA primero)
STRIPE_SECRET_KEY=
# Stripe: se genera al crear el webhook (panel > Desarrolladores > Webhooks)
STRIPE_WEBHOOK_SECRET=
# Firebase: Consola > Config. del proyecto > Cuentas de servicio > Generar clave privada.
# Pega TODO el JSON en una sola linea.
FIREBASE_SERVICE_ACCOUNT=
